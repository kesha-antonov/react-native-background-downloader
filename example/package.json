{
  "name": "example",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node ./scripts/postinstall.js",
    "start": "npx expo start --dev-client --clear",
    "start:android": "npx expo start --android --dev-client --clear",
    "start:ios": "npx expo start --ios --dev-client --clear",
    "start:web": "npx expo start --web --clear",
    "lint": "npx expo lint",
    "fresh": "yarn start --reset-cache",
    "installDevBuild:ios": "npx expo run:ios",
    "installDevBuild:android": "npx expo run:android",
    "rebuildNativeDeps": "npx expo prebuild",
    "rebuildNativeDeps:clean": "npx expo prebuild --clean",
    "freshAndroid": "npx expo prebuild --clean && npx expo run:android",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@kesha-antonov/react-native-background-downloader": "link:..",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/stack": "^7.12.1",
    "expo": "^58.0.0",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-root-siblings": "^5.0.1",
    "react-native-root-toast": "^4.0.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native-community/cli": "^20.2.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "resolutions": {
    "postcss": "^8.5.10"
  },
  "packageManager": "yarn@4.17.1"
}
